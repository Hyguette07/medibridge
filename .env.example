# Copy to .env and fill in. Never commit the real .env file.

# --- Backend ---
SERVER_PORT=8084
SPRING_PROFILES_ACTIVE=local
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION_MS=86400000
CORS_ORIGINS=http://localhost:3004
APP_SEED_PASSWORD=ChangeMe123!
SEED_DEMO_DATA=true

# Used when SPRING_PROFILES_ACTIVE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medibridge
DB_USER=medibridge
DB_PASSWORD=replace-with-a-strong-database-password

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8084/api/v1
